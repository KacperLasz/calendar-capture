# Copy to supabase/functions/.env for local use (that is where `supabase functions serve` looks).
# For production use `supabase secrets set` instead (see README.md).

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Any long random string; the Shortcut sends it in the x-shortcut-secret header.
# Generate one with: openssl rand -hex 32
SHORTCUT_SECRET=

# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Defaults to Europe/Dublin.
# DEFAULT_TIMEZONE=Europe/Dublin
